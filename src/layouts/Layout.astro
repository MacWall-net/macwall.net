---
import { url } from '../url';

interface Props {
  title: string;
  description: string;
  current?: 'support' | 'privacy';
}

const { title, description, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="stylesheet" href={url('style.css')} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2.5 4.5 6.8v8.4c0 7.2 4.9 12.4 11.5 14.3 6.6-1.9 11.5-7.1 11.5-14.3V6.8Z" fill="var(--accent)"/><path d="m10.5 16.2 3.8 3.8 7.4-8" fill="none" stroke="var(--bg)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          MacWall
        </a>
        <nav class="nav" aria-label="Main">
          <a href={url('support/')} aria-current={current === 'support' ? 'page' : undefined}>Support</a>
          <a href={url('privacy/')} aria-current={current === 'privacy' ? 'page' : undefined}>Privacy</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 macwall.net</span>
        <nav aria-label="Footer">
          <a href={url('')}>Home</a>
          <a href={url('support/')}>Support</a>
          <a href={url('privacy/')}>Privacy Policy</a>
          <a href="https://github.com/MacWall-net/">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
