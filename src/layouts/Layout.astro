---
import { url } from '../url';

interface Props {
  title: string;
  description: string;
  current?: 'support' | 'privacy';
}

const { title, description, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="stylesheet" href={url('style.css')} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>
          <img src={url('app-icon.png')} width="30" height="30" alt="" />
          MacWall
        </a>
        <nav class="nav" aria-label="Main">
          <a href={url('support/')} aria-current={current === 'support' ? 'page' : undefined}>Support</a>
          <a href={url('privacy/')} aria-current={current === 'privacy' ? 'page' : undefined}>Privacy</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <span>© 2026 macwall.net</span>
        <nav aria-label="Footer">
          <a href={url('')}>Home</a>
          <a href={url('support/')}>Support</a>
          <a href={url('privacy/')}>Privacy Policy</a>
          <a href="https://github.com/MacWall-net/">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
